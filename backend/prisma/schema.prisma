generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoUser {
  cliente
  admin
}

enum CategoriaProduto {
  computador
  hardware
  periferico
  jogo_digital
}

enum TipoEntrega {
  fisico
  digital
}

enum FormaPagamento {
  pix
  cartao
  boleto
}

enum StatusPedido {
  pendente
  pago
  enviado
  entregue
  cancelado
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nome             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(150)
  senha_hash       String    @db.VarChar(255)
  cpf              String    @unique @db.VarChar(14)
  cep              String    @db.VarChar(9)
  endereco         String    @db.VarChar(200)
  numero           String    @db.VarChar(20)
  bairro           String    @db.VarChar(100)
  cidade           String    @db.VarChar(100)
  estado           String    @db.Char(2)
  tipo             TipoUser  @default(cliente)
  ativo            Boolean   @default(true)
  tentativas_login Int       @default(0)
  bloqueado_ate    DateTime?
  criado_em        DateTime  @default(now())

  pedidos          Pedido[]
  avaliacoes       Avaliacao[]
  logs             LogSistema[]

  @@map("usuarios")
}

model Produto {
  id           Int              @id @default(autoincrement())
  nome         String           @db.VarChar(150)
  descricao    String?          @db.Text
  preco        Decimal          @db.Decimal(10, 2)
  categoria    CategoriaProduto
  tipo_entrega TipoEntrega
  estoque      Int              @default(0)
  imagem_url   String?          @db.VarChar(255)
  criado_em    DateTime         @default(now())

  itens_pedido ItemPedido[]
  avaliacoes   Avaliacao[]

  @@map("produtos")
}

model Pedido {
  id              Int            @id @default(autoincrement())
  usuario_id      Int
  valor_total     Decimal        @db.Decimal(10, 2)
  valor_frete     Decimal        @default(0.00) @db.Decimal(10, 2)
  forma_pagamento FormaPagamento @default(pix)
  status          StatusPedido   @default(pendente)
  criado_em       DateTime       @default(now())

  usuario         Usuario        @relation(fields: [usuario_id], references: [id])
  itens           ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id             Int     @id @default(autoincrement())
  pedido_id      Int
  produto_id     Int
  quantidade     Int     @default(1)
  preco_unitario Decimal @db.Decimal(10, 2)
  chave_ativacao String? @db.VarChar(50)

  pedido         Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto        Produto @relation(fields: [produto_id], references: [id])

  @@map("itens_pedido")
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  produto_id Int
  nota       Int
  comentario String   @db.Text
  foto_url   String?  @db.VarChar(255)
  aprovado   Boolean  @default(false)
  criado_em  DateTime @default(now())

  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  produto    Produto  @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@map("avaliacoes")
}

model LogSistema {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  acao       String   @db.VarChar(255)
  ip         String?  @db.VarChar(45)
  criado_em  DateTime @default(now())

  usuario    Usuario? @relation(fields: [usuario_id], references: [id])

  @@map("logs_sistema")
}